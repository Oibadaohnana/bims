#!/usr/bin/env bash
# One entry point for the things this repo can run.
#
#   ./run game       the room — the simulation, on a canvas
#   ./run builder    the menus in front of it: start, setup, lobby
#
# Both serve the *live* web/ directory, which is the difference between this
# and `nix run .#game` / `nix run .#builder`: those serve a frozen copy out of
# the Nix store and will not notice an edit until they are restarted.
#
# Each front end has its own default port, so the two can be up at once.
# Anything after the name is passed on to dev-server.py — a port, --no-open.
set -euo pipefail
cd "$(dirname "$0")"

usage() {
  echo "usage: ./run <game|builder> [port] [--no-open]" >&2
  exit 2
}

[ $# -ge 1 ] || usage

case "$1" in
  game)
    page=index.html
    port=8080
    ;;
  builder)
    page=builder.html
    port=8081
    ;;
  -h | --help) usage ;;
  *)
    echo "./run: no such thing to run: $1" >&2
    usage
    ;;
esac
shift

./build.sh

if command -v python3 >/dev/null; then
  exec python3 dev-server.py --page "$page" --default-port "$port" "$@"
else
  exec nix-shell shell.nix --run \
    "python3 dev-server.py --page $page --default-port $port $*"
fi
