#!/usr/bin/env bash
# Every check this repo has, behind one command and one verdict.
#
#   ./check             the quick tier — a couple of minutes:
#                         tracked  every source file is in the git tree
#                         js       the host parses, and the traps CLAUDE.md lists
#                         fmt      cargo fmt --check
#                         build    the three wasm modules, into web/
#                         harness  every scratchpad/*-check.mjs and smoke.mjs
#                         test     the libraries' cargo tests, natively
#   ./check full        the quick tier and then:
#                         probes   the room's native probes, compiled fresh
#                         flake    nix flake check
#   ./check <step>...   only those steps, in that order
#   ./check --list      the steps and what each is for
#
# Why this exists: the checks were a dozen invocations spread through CLAUDE.md,
# each with a target or a wrapper to remember, and a check that has to be
# remembered is a check that gets skipped. Everything here is what that file
# says to run; nothing is new. Each step's full output goes to
# target/check/<step>.log and only the failing lines are printed.
#
# Two things about how it runs:
#
#   * The toolchain comes from shell.nix. If cargo and node are not on PATH
#     already the whole script re-runs itself inside `nix-shell shell.nix`,
#     so it works the same from a bare terminal and from a direnv'd one.
#   * The probes are compiled into target/probes/, never into scratchpad/.
#     rustc failing leaves the previous binary in place, and a stale binary
#     printing a confident pass is how three rounds of bugs got through — so
#     a compile failure here is a step failure, and the binary that ran is
#     always the one just built.
set -uo pipefail
cd "$(dirname "$0")"

if ! command -v cargo >/dev/null || ! command -v node >/dev/null; then
  exec nix-shell shell.nix --run "./check $*"
fi

QUICK=(tracked js fmt build harness test)
FULL=("${QUICK[@]}" probes flake)

# The libraries with plain `cargo test` tests. `bims` is deliberately absent —
# its tests are the probes and the harnesses. `ship` and `lobby` are cdylibs
# and on the list anyway: each is also an rlib whose tests.rs is pure
# arithmetic no harness can see go wrong.
TESTED=(time physics worldgen shipdesign economy health flight world ship lobby)
NATIVE=x86_64-unknown-linux-gnu

LOGS=target/check
mkdir -p "$LOGS" target/probes

# ---------------------------------------------------------------------------
# the steps

describe() {
  cat <<'EOF'
tracked   every file under crates/, web/ and scratchpad/ is known to git —
          `nix run .` and `nix flake check` build from the git tree, and a
          file that is only on disk is a build that cannot find its module
js        node --check on every web/*.js; no NUL byte in any page or script;
          no duplicate `function` inside a page's boot() scope; no top-level
          const shadowed inside boot(); nothing crew.js declares at the top
          declared again in the pages that load it
fmt       cargo fmt --check
build     ./build.sh — the three wasm modules copied into web/, which is what
          the harnesses load
harness   every scratchpad/*-check.mjs and smoke.mjs against the real wasm
test      cargo test, natively, for every library crate
probes    every scratchpad/*.rs probe compiled fresh into target/probes/ and
          run; a compile failure is a failure
flake     nix flake check — the build as `nix run .` sees it, from the git tree
EOF
}

step_tracked() {
  local stray
  stray=$(git ls-files --others --exclude-standard crates web scratchpad)
  if [ -n "$stray" ]; then
    echo "not in the git tree (nix builds from it — \`git add -N\` each):"
    echo "$stray" | sed 's/^/  /'
    return 1
  fi
  echo "every source file is tracked"
}

step_js() {
  local fail=0 f

  for f in web/*.js; do
    if node --check "$f" 2>"$LOGS/js-parse.err"; then
      echo "  ok   $f parses"
    else
      echo "  FAIL $f does not parse"
      sed 's/^/       /' "$LOGS/js-parse.err"
      fail=1
    fi
  done

  for f in web/*.js web/*.html web/*.css; do
    if [ "$(wc -c <"$f")" != "$(tr -d '\000' <"$f" | wc -c)" ]; then
      echo "  FAIL $f contains a NUL byte"
      fail=1
    fi
  done
  echo "  ok   no NUL bytes in web/"

  # Two `function foo()` in one scope: the later one silently wins.
  for f in web/*.js; do
    local dups
    dups=$(command grep -o "^  function [a-zA-Z_]*" "$f" | sed 's/.*function //' | sort | uniq -d)
    if [ -n "$dups" ]; then
      echo "  FAIL $f declares a function twice in boot(): $(echo "$dups" | tr '\n' ' ')"
      fail=1
    fi
  done
  echo "  ok   no function declared twice inside a boot()"

  # A const inside boot() shadowing a top-level one: no error, wrong table.
  for f in web/*.js; do
    local shadowed
    shadowed=$(comm -12 \
      <(command grep -o "^const [A-Za-z_]*" "$f" | sed 's/const //' | sort) \
      <(command grep -o "^  const [A-Za-z_]*" "$f" | sed 's/.*const //' | sort))
    if [ -n "$shadowed" ]; then
      echo "  FAIL $f shadows a top-level const inside boot(): $(echo "$shadowed" | tr '\n' ' ')"
      fail=1
    fi
  done
  echo "  ok   no top-level const shadowed inside a boot()"

  # crew.js is loaded before bims.js and ship.js, into the same global scope.
  local shared
  shared=$(command grep -oE "^(const|let|var|function|class) [A-Za-z_]+" web/crew.js | awk '{print $2}' | sort -u)
  for f in web/bims.js web/ship.js; do
    local clash
    clash=$(comm -12 <(echo "$shared") \
      <(command grep -oE "^ {0,2}(const|let|var|function|class) [A-Za-z_]+" "$f" | awk '{print $2}' | sort -u))
    if [ -n "$clash" ]; then
      echo "  FAIL $f redeclares a name from crew.js: $(echo "$clash" | tr '\n' ' ')"
      fail=1
    fi
  done
  echo "  ok   nothing in crew.js is declared again by a page"

  return $fail
}

step_fmt() {
  cargo fmt --check -- --color never
}

step_build() {
  ./build.sh
}

step_harness() {
  local fail=0 h name
  for h in scratchpad/smoke.mjs scratchpad/*-check.mjs; do
    name=$(basename "$h" .mjs)
    if node "$h" >"$LOGS/harness-$name.log" 2>&1; then
      echo "  ok   $name"
    else
      echo "  FAIL $name"
      command grep -E "FAIL|^[A-Za-z]*Error:|^ +at " "$LOGS/harness-$name.log" | head -20 | sed 's/^/       /'
      tail -1 "$LOGS/harness-$name.log" | sed 's/^/       /'
      fail=1
    fi
  done
  return $fail
}

step_test() {
  local args=()
  local c
  for c in "${TESTED[@]}"; do args+=(-p "$c"); done
  if cargo test --target "$NATIVE" "${args[@]}" >"$LOGS/test.log" 2>&1; then
    command grep -E "^test result" "$LOGS/test.log" |
      awk '{p+=$4; f+=$6; i+=$8} END {printf "  %d passed, %d failed, %d ignored\n", p, f, i}'
  else
    command grep -E "FAILED|panicked at|^error" "$LOGS/test.log" | command grep -v "^test result" | head -30 | sed 's/^/  /'
    command grep -E "^test result" "$LOGS/test.log" |
      awk '{p+=$4; f+=$6; i+=$8} END {printf "  %d passed, %d failed, %d ignored\n", p, f, i}'
    return 1
  fi
}

step_probes() {
  local fail=0 src name bin
  for src in scratchpad/*.rs; do
    name=$(basename "$src" .rs)
    # modules.rs is the shared module list; layout.rs is a picture, not a test.
    case "$name" in modules | layout) continue ;; esac
    bin="target/probes/$name"
    rm -f "$bin"
    if ! rustc --edition 2024 -O "$src" -o "$bin" >"$LOGS/probe-$name.log" 2>&1; then
      echo "  FAIL $name did not compile"
      command grep -E "^error" -A 6 "$LOGS/probe-$name.log" | head -30 | sed 's/^/       /'
      fail=1
      continue
    fi
    if "$bin" >"$LOGS/probe-$name.log" 2>&1; then
      echo "  ok   $name"
    else
      echo "  FAIL $name"
      command grep -E "FAIL|panicked" "$LOGS/probe-$name.log" | head -20 | sed 's/^/       /'
      fail=1
    fi
  done
  return $fail
}

step_flake() {
  nix flake check
}

# ---------------------------------------------------------------------------
# the runner

usage() {
  sed -n '4,/^#$/p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

steps=()
case "${1:-}" in
  "") steps=("${QUICK[@]}") ;;
  full) steps=("${FULL[@]}") ;;
  --list | -l) describe; exit 0 ;;
  -h | --help) usage ;;
  *)
    for s in "$@"; do
      if ! declare -F "step_$s" >/dev/null; then
        echo "./check: no such step: $s" >&2
        echo "steps: ${FULL[*]}" >&2
        exit 2
      fi
      steps+=("$s")
    done
    ;;
esac

failed=()
summary=()
began=$SECONDS
for s in "${steps[@]}"; do
  echo "== $s"
  start=$SECONDS
  # Steps that print their own per-item lines write to the terminal; the rest
  # are quiet on success and shown in full on failure.
  case "$s" in
    tracked | js | harness | test | probes)
      if "step_$s"; then ok=1; else ok=0; fi
      ;;
    *)
      if "step_$s" >"$LOGS/$s.log" 2>&1; then
        ok=1
      else
        ok=0
        tail -40 "$LOGS/$s.log" | sed 's/^/  /'
      fi
      ;;
  esac
  took=$((SECONDS - start))
  if [ $ok = 1 ]; then
    summary+=("$(printf '  ok    %-8s %4ss' "$s" "$took")")
  else
    summary+=("$(printf '  FAIL  %-8s %4ss   target/check/%s*.log' "$s" "$took" "$s")")
    failed+=("$s")
  fi
done

echo
echo "== summary ($((SECONDS - began))s)"
printf '%s\n' "${summary[@]}"
if [ ${#failed[@]} -gt 0 ]; then
  echo "FAILED: ${failed[*]}"
  exit 1
fi
echo "all green"
