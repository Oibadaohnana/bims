#!/usr/bin/env bash
# One entry point for the things this repo can run.
#
#   ./run game          the whole game, in order: menu, lobby, world pick,
#                       ship design, then the world docked where you said
#   ./run simulation    straight into the world on the playtest ship
#   ./run room          the behaviour test room — the Bims on a deck
#
# All three serve the *live* web/ directory, which is the difference between
# this and `nix run .#game` / `.#simulation` / `.#room`: those serve a frozen
# copy out of the Nix store and will not notice an edit until they are
# restarted.
#
# Each front end has its own default port, so they can all be up at once.
# Anything after the name is passed on to dev-server.py — a port, --no-open.
set -euo pipefail
cd "$(dirname "$0")"

usage() {
  echo "usage: ./run <game|simulation|room> [port] [--no-open]" >&2
  exit 2
}

[ $# -ge 1 ] || usage

# Each front end carries the modules it loads as well as its page and its
# port. The server tells one build from another by hashing those modules
# together, so a front end identified by only some of what it serves would
# look unchanged after a rebuild that changed the rest. The game is two pages
# — the builder and the designer it starts — and so two modules.
case "$1" in
  game)
    page=builder.html
    wasm=(--wasm lobby.wasm --wasm ship.wasm)
    port=8080
    ;;
  simulation)
    page='ship.html?mode=1'
    wasm=(--wasm ship.wasm)
    port=8083
    ;;
  room)
    page=index.html
    wasm=(--wasm bims.wasm)
    port=8084
    ;;
  -h | --help) usage ;;
  *)
    echo "./run: no such thing to run: $1" >&2
    usage
    ;;
esac
shift

./build.sh

if command -v python3 >/dev/null; then
  exec python3 dev-server.py \
    --page "$page" "${wasm[@]}" --default-port "$port" "$@"
else
  exec nix-shell shell.nix --run \
    "python3 dev-server.py --page '$page' ${wasm[*]} --default-port $port $*"
fi
