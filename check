#!/usr/bin/env bash
# Every check this repo has, behind one command and one verdict.
#
#   ./check             the quick tier — a few minutes:
#                         tracked  every source file is in the git tree
#                         fmt      cargo fmt --check
#                         build    cargo build, the app and every crate
#                         test     cargo test --workspace
#                         clippy   cargo clippy on the app, warnings as errors
#                         smoke    each of the six things to run opens a
#                                  window, draws sixty frames and exits; the
#                                  room, the simulation and the yard are screenshotted
#                                  into target/check/ to look at
#   ./check full        the quick tier and then:
#                         probes   the room's native probes, compiled fresh
#                         flake    nix flake check
#   ./check <step>...   only those steps, in that order
#   ./check --list      the steps and what each is for
#
# Why this exists: a check that has to be remembered is a check that gets
# skipped. Each step's full output goes to target/check/<step>.log and only
# the failing lines are printed.
#
# Two things about how it runs:
#
#   * The toolchain comes from shell.nix. If cargo is not on PATH already
#     the whole script re-runs itself inside `nix-shell shell.nix`, so it
#     works the same from a bare terminal and from a direnv'd one. The
#     smoke step needs the shell either way, for the libraries winit and
#     wgpu open at runtime, so it re-enters the shell itself if it has to.
#   * The probes are compiled into target/probes/, never into scratchpad/.
#     rustc failing leaves the previous binary in place, and a stale binary
#     printing a confident pass is how three rounds of bugs got through — so
#     a compile failure here is a step failure, and the binary that ran is
#     always the one just built.
set -uo pipefail
cd "$(dirname "$0")"

if ! command -v cargo >/dev/null; then
  exec nix-shell shell.nix --run "./check $*"
fi

QUICK=(tracked fmt build test clippy smoke)
FULL=("${QUICK[@]}" probes flake)

LOGS=target/check
mkdir -p "$LOGS" target/probes

# ---------------------------------------------------------------------------
# the steps

describe() {
  cat <<'EOF'
tracked   every file under crates/ and scratchpad/ is known to git —
          `nix run .` and `nix flake check` build from the git tree, and a
          file that is only on disk is a build that cannot find its module
fmt       cargo fmt --check
build     cargo build --workspace: the app, and every crate it stands on
test      cargo test --workspace: the rules crates' pinned arithmetic, the
          designer's and lobby's geometry, and the app's tables against them
clippy    cargo clippy on the app crate, with warnings as errors
smoke     `bims game`, `simulation`, `design`, `room`, `test` and `combat` each run
          sixty frames in a hidden window and exit; the room, the simulation, the yard
          and the combat dock leave a
          screenshot in target/check/ — a black picture is a bug no test sees
probes    every scratchpad/*.rs probe compiled fresh into target/probes/ and
          run; a compile failure is a failure
flake     nix flake check — the build as `nix run .` sees it, from the git tree
EOF
}

step_tracked() {
  local stray
  stray=$(git ls-files --others --exclude-standard crates scratchpad)
  if [ -n "$stray" ]; then
    echo "not in the git tree (nix builds from it — \`git add -N\` each):"
    echo "$stray" | sed 's/^/  /'
    return 1
  fi
  echo "every source file is tracked"
}

step_fmt() {
  cargo fmt --check -- --color never
}

step_build() {
  cargo build --workspace
}

step_test() {
  if cargo test --workspace >"$LOGS/test.log" 2>&1; then
    command grep -E "^test result" "$LOGS/test.log" |
      awk '{p+=$4; f+=$6; i+=$8} END {printf "  %d passed, %d failed, %d ignored\n", p, f, i}'
  else
    command grep -E "FAILED|panicked at|^error" "$LOGS/test.log" | command grep -v "^test result" | head -30 | sed 's/^/  /'
    command grep -E "^test result" "$LOGS/test.log" |
      awk '{p+=$4; f+=$6; i+=$8} END {printf "  %d passed, %d failed, %d ignored\n", p, f, i}'
    return 1
  fi
}

step_clippy() {
  # The app only. The rules crates predate clippy here and carry a few
  # hundred style lints that are not bugs; the app was written under it.
  cargo clippy -p app --no-deps --all-targets -- -D warnings
}

step_smoke() {
  local fail=0 what shot
  # The window system's libraries are on LD_LIBRARY_PATH only inside the
  # shell; a bare terminal with cargo on PATH is not enough for this step.
  if [ -z "${LD_LIBRARY_PATH:-}" ] || ! [[ "$LD_LIBRARY_PATH" == *vulkan-loader* ]]; then
    exec_in_shell=1
  else
    exec_in_shell=0
  fi
  for what in game simulation design room test combat; do
    shot=""
    case "$what" in room | simulation | design | combat) shot="$LOGS/smoke-$what.png" ;; esac
    rm -f "$shot"
    local cmd="BIMS_SMOKE_FRAMES=60 BIMS_FULLSCREEN=1 ${shot:+BIMS_SCREENSHOT=$shot} target/debug/bims $what"
    if [ $exec_in_shell = 1 ]; then
      cmd="nix-shell shell.nix --run '$cmd'"
    fi
    if timeout 120 bash -c "$cmd" >"$LOGS/smoke-$what.log" 2>&1 && { [ -z "$shot" ] || [ -s "$shot" ]; }; then
      echo "  ok   $what${shot:+  → $shot}"
    else
      echo "  FAIL $what"
      command grep -iE "panic|error" "$LOGS/smoke-$what.log" | head -10 | sed 's/^/       /'
      fail=1
    fi
  done
  return $fail
}

step_probes() {
  local fail=0 src name bin
  for src in scratchpad/*.rs; do
    name=$(basename "$src" .rs)
    # modules.rs is the shared module list; layout.rs is a picture, not a test.
    case "$name" in modules | layout) continue ;; esac
    bin="target/probes/$name"
    rm -f "$bin"
    if ! rustc --edition 2024 -O "$src" -o "$bin" >"$LOGS/probe-$name.log" 2>&1; then
      echo "  FAIL $name did not compile"
      command grep -E "^error" -A 6 "$LOGS/probe-$name.log" | head -30 | sed 's/^/       /'
      fail=1
      continue
    fi
    if "$bin" >"$LOGS/probe-$name.log" 2>&1; then
      echo "  ok   $name"
    else
      echo "  FAIL $name"
      command grep -E "FAIL|panicked" "$LOGS/probe-$name.log" | head -20 | sed 's/^/       /'
      fail=1
    fi
  done
  return $fail
}

step_flake() {
  nix flake check
}

# ---------------------------------------------------------------------------
# the runner

usage() {
  sed -n '4,/^#$/p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

steps=()
case "${1:-}" in
  "") steps=("${QUICK[@]}") ;;
  full) steps=("${FULL[@]}") ;;
  --list | -l) describe; exit 0 ;;
  -h | --help) usage ;;
  *)
    for s in "$@"; do
      if ! declare -F "step_$s" >/dev/null; then
        echo "./check: no such step: $s" >&2
        echo "steps: ${FULL[*]}" >&2
        exit 2
      fi
      steps+=("$s")
    done
    ;;
esac

failed=()
summary=()
began=$SECONDS
for s in "${steps[@]}"; do
  echo "== $s"
  start=$SECONDS
  # Steps that print their own per-item lines write to the terminal; the rest
  # are quiet on success and shown in full on failure.
  case "$s" in
    tracked | test | smoke | probes)
      if "step_$s"; then ok=1; else ok=0; fi
      ;;
    *)
      if "step_$s" >"$LOGS/$s.log" 2>&1; then
        ok=1
      else
        ok=0
        tail -40 "$LOGS/$s.log" | sed 's/^/  /'
      fi
      ;;
  esac
  took=$((SECONDS - start))
  if [ $ok = 1 ]; then
    summary+=("$(printf '  ok    %-8s %4ss' "$s" "$took")")
  else
    summary+=("$(printf '  FAIL  %-8s %4ss   target/check/%s*.log' "$s" "$took" "$s")")
    failed+=("$s")
  fi
done

echo
echo "== summary ($((SECONDS - began))s)"
printf '%s\n' "${summary[@]}"
if [ ${#failed[@]} -gt 0 ]; then
  echo "FAILED: ${failed[*]}"
  exit 1
fi
echo "all green"
